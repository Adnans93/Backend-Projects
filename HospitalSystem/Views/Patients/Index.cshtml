@model IEnumerable<Patient>
@{
    ViewData["Title"] = "المرضى";
    ViewData["Subtitle"] = "سجل المرضى المسجلين في المستشفى";
    var canCreate = Perms.Has(AppPermissions.PatientsCreate);
    var canEdit = Perms.Has(AppPermissions.PatientsEdit);
    var canDelete = Perms.Has(AppPermissions.PatientsDelete);
}

@section PageActions {
    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> إضافة مريض</a>
    }
}

<div class="card">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
        <form asp-action="Index" method="get" class="search-box">
            <i class="bi bi-search"></i>
            <input type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث بالاسم أو رقم الهاتف..." />
        </form>
        <span class="text-muted-2 ms-auto small">@Model.Count() مريض</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>المريض</th>
                    <th>رقم الهاتف</th>
                    <th>العنوان</th>
                    <th style="width:150px">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4"><div class="empty-state"><i class="bi bi-people"></i>لا يوجد مرضى @(ViewBag.Search != null ? "مطابقين للبحث" : "")</div></td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="person text-reset">
                                <span class="avatar bg-primary"><i class="bi bi-person"></i></span>
                                <div>
                                    <div class="name">@item.Name</div>
                                    <div class="sub">رقم الملف #@item.Id</div>
                                </div>
                            </a>
                        </td>
                        <td dir="ltr" class="text-end">@item.Phone</td>
                        <td class="text-muted-2">@(string.IsNullOrWhiteSpace(item.Address) ? "—" : item.Address)</td>
                        <td>
                            <div class="actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-icon info" title="ملف المريض"><i class="bi bi-folder2-open"></i></a>
                                @if (canEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-icon edit" title="تعديل"><i class="bi bi-pencil"></i></a>
                                }
                                @if (canDelete)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('حذف المريض سيحذف مواعيده وسجلاته الطبية، هل أنت متأكد؟');">
                                        <button type="submit" class="btn btn-icon danger" title="حذف"><i class="bi bi-trash3"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
