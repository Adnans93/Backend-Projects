@model IEnumerable<DoctorDto>
@{
    ViewData["Title"] = "الأطباء";
    ViewData["Subtitle"] = $"{Model.Count()} طبيب في المستشفى";
    var canManage = Perms.Has(AppPermissions.DoctorsManage);
}

@section PageActions {
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="search" id="doctorSearch" class="form-control" placeholder="بحث عن طبيب أو عيادة..." />
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> إضافة طبيب</a>
    }
}

@if (!Model.Any())
{
    <div class="card"><div class="empty-state"><i class="bi bi-person-badge"></i>لا يوجد أطباء بعد</div></div>
}

<div class="row g-3" id="doctorsGrid">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-xl-4 doctor-item" data-search="@item.Name @item.ClinicName @item.JobName">
            <div class="card dept-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(item.ImageURL))
                        {
                            <img src="@(item.ImageURL)" class="avatar" alt="" />
                        }
                        else
                        {
                            <span class="avatar bg-primary"><i class="bi bi-person"></i></span>
                        }
                        <div class="flex-grow-1 overflow-hidden">
                            <a asp-action="Details" asp-route-id="@item.Id" class="h6 fw-bold mb-1 d-block text-truncate text-white">@item.Name</a>
                            <div class="d-flex flex-wrap gap-1">
                                <span class="badge badge-soft-info"><i class="bi bi-hospital me-1"></i>@(item.ClinicName ?? "بدون عيادة")</span>
                                @if (item.JobName != null)
                                {
                                    <span class="badge badge-soft-secondary">@item.JobName</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="small text-muted-2 mb-1 text-truncate"><i class="bi bi-envelope me-2"></i>@item.Email</div>
                    <div class="small text-muted-2"><i class="bi bi-telephone me-2"></i><span dir="ltr">@item.Phone</span></div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary flex-grow-1"><i class="bi bi-eye me-1"></i> الملف</a>
                    @if (canManage)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-icon edit" title="تعديل"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('حذف الطبيب سيحذف مواعيده أيضاً، هل أنت متأكد؟');">
                            <button type="submit" class="btn btn-icon danger" title="حذف"><i class="bi bi-trash3"></i></button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('doctorSearch')?.addEventListener('input', e => {
            const q = e.target.value.trim();
            document.querySelectorAll('.doctor-item').forEach(el =>
                el.style.display = el.dataset.search.includes(q) ? '' : 'none');
        });
    </script>
}
