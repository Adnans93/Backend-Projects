@model DoctorDto
@{
    ViewData["Title"] = "ملف الطبيب";
    var canManage = Perms.Has(AppPermissions.DoctorsManage);
}

@section PageActions {
    @if (canManage)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> تعديل</a>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
}

<div class="card form-card">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4">
            @if (!string.IsNullOrEmpty(Model.ImageURL))
            {
                <img src="@(Model.ImageURL)" class="avatar avatar-lg" alt="" />
            }
            else
            {
                <span class="avatar avatar-lg bg-primary"><i class="bi bi-person"></i></span>
            }
            <div>
                <h3 class="fw-bold mb-2">@Model.Name</h3>
                <span class="badge badge-soft-info"><i class="bi bi-hospital me-1"></i>@(Model.ClinicName ?? "بدون عيادة")</span>
                @if (Model.JobName != null)
                {
                    <span class="badge badge-soft-secondary">@Model.JobName</span>
                }
            </div>
        </div>
        <div class="info-list">
            <div class="item">
                <span class="icon"><i class="bi bi-envelope"></i></span>
                <div><div class="label">البريد الإلكتروني</div><div class="fw-bold">@Model.Email</div></div>
            </div>
            <div class="item">
                <span class="icon"><i class="bi bi-telephone"></i></span>
                <div><div class="label">رقم الهاتف</div><div class="fw-bold" dir="ltr">@Model.Phone</div></div>
            </div>
        </div>
    </div>
</div>
