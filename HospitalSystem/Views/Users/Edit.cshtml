@model UpdateUserDto
@{
    ViewData["Title"] = "تعديل مستخدم";
    ViewData["Subtitle"] = "تحديث بيانات الحساب";
}

<div class="card form-card">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="d-flex align-items-center gap-3 mb-4">
                @if (!string.IsNullOrEmpty(ViewBag.ImageURL as string))
                {
                    <img src="@(ViewBag.ImageURL as string)" class="avatar avatar-lg" alt="" />
                }
                else
                {
                    <span class="avatar avatar-lg bg-primary"><i class="bi bi-person"></i></span>
                }
                <div class="flex-grow-1">
                    <label asp-for="image" class="form-label">الصورة الشخصية</label>
                    <input asp-for="image" type="file" class="form-control" accept="image/*" />
                </div>
            </div>

            <div class="section-title">بيانات الحساب</div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label">الاسم</label>
                    <input asp-for="Name" class="form-control" placeholder="الاسم الكامل" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                    <input asp-for="Email" type="email" class="form-control" dir="ltr" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Username" class="form-label">اسم المستخدم</label>
                    <input asp-for="Username" class="form-control" dir="ltr" autocomplete="off" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label">كلمة المرور</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="اتركها فارغة إذا لا تريد تغييرها" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>

            <div class="section-title">حساب طبيب</div>
            <div class="mb-1">
                <label asp-for="DoctorId" class="form-label">ربط الحساب بطبيب</label>
                <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select">
                    <option value="">-- ليس طبيباً --</option>
                </select>
                <small class="text-muted-2">إذا كان المستخدم طبيباً اربطه بسجله، ليرى مواعيده هو فقط (مع دور Doctor).</small>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i> حفظ التعديلات</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
</div>
