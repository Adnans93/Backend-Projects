@model Role
@{
    ViewData["Title"] = "صلاحيات الدور";
    ViewData["Subtitle"] = $"حدد ما يستطيع دور \"{Model.Name}\" فعله في النظام";
    var all = ViewBag.AllPermissions as List<Permission> ?? new List<Permission>();
    var assigned = ViewBag.AssignedPermissions as List<int> ?? new List<int>();
    var groups = new (string Prefix, string Title, string Icon)[]
    {
        ("Appointments.", "المواعيد", "bi-calendar2-check"),
        ("Patients.", "المرضى", "bi-people"),
        ("MedicalRecords.", "السجلات الطبية", "bi-file-earmark-medical"),
        ("Doctors.", "الأطباء", "bi-person-badge"),
        ("Clinics.", "العيادات", "bi-hospital"),
        ("Jobs.", "المسميات الوظيفية", "bi-briefcase"),
        ("Users.", "المستخدمين", "bi-person-gear"),
        ("Roles.", "الأدوار والصلاحيات", "bi-shield-lock"),
    };
    var custom = all.Where(p => !AppPermissions.IsSystem(p.Name)).ToList();
}

<form asp-action="AssignPermissions" method="post">
    <input type="hidden" name="roleId" value="@Model.Id" />

    <div class="row g-3 mb-3">
        @foreach (var g in groups)
        {
            var items = all.Where(p => p.Name != null && p.Name.StartsWith(g.Prefix)).ToList();
            if (!items.Any()) { continue; }
            <div class="col-md-6 col-xl-4">
                <div class="perm-group">
                    <h6><i class="bi @g.Icon text-primary"></i> @g.Title</h6>
                    @foreach (var p in items)
                    {
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" name="permissionIds" value="@p.Id" id="perm_@p.Id" checked="@assigned.Contains(p.Id)" />
                            <label class="form-check-label" for="perm_@p.Id">@AppPermissions.DisplayName(p.Name)</label>
                        </div>
                    }
                </div>
            </div>
        }
        @if (custom.Any())
        {
            <div class="col-md-6 col-xl-4">
                <div class="perm-group">
                    <h6><i class="bi bi-plus-circle text-primary"></i> صلاحيات إضافية</h6>
                    @foreach (var p in custom)
                    {
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" name="permissionIds" value="@p.Id" id="perm_@p.Id" checked="@assigned.Contains(p.Id)" />
                            <label class="form-check-label" for="perm_@p.Id">@p.Name</label>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i> حفظ الصلاحيات</button>
        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
    </div>
</form>
