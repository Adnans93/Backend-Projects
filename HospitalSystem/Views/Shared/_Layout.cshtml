@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string controller) => currentController == controller ? "active" : "";
    var fullName = User.FindFirst(UserService.ClaimFullName)?.Value ?? User.Identity?.Name;
    var perms = Perms.GetPermissions();
    bool Can(params string[] keys) => keys.Any(perms.Contains);
    var arCulture = new System.Globalization.CultureInfo("ar-SA") { DateTimeFormat = { Calendar = new System.Globalization.GregorianCalendar() } };
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة المستشفيات</title>

    <link rel="stylesheet" href="~/lib/tajawal/tajawal.css">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/overlayscrollbars/overlayscrollbars.min.css">
    <!-- AdminLTE 4 RTL (يحتوي على Bootstrap 5) -->
    <link rel="stylesheet" href="~/template/css/adminlte.rtl.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-fixed sidebar-expand-lg">
    <div class="app-wrapper">

        <!-- الشريط العلوي -->
        <nav class="app-header navbar navbar-expand">
            <div class="container-fluid">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button"><i class="bi bi-list fs-5"></i></a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <span class="nav-link text-muted-2"><i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dddd، d MMMM yyyy", arCulture)</span>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <li class="nav-item d-none d-sm-flex align-items-center gap-2">
                        <span class="avatar avatar-sm bg-primary"><i class="bi bi-person"></i></span>
                        <span class="fw-bold">@fullName</span>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Accounts" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-icon danger" title="تسجيل الخروج"><i class="bi bi-box-arrow-left"></i></button>
                        </form>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- القائمة الجانبية -->
        <aside class="app-sidebar" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a asp-controller="Home" asp-action="Index" class="brand-link">
                    <span class="brand-logo"><i class="bi bi-heart-pulse-fill"></i></span>
                    <span class="brand-text">نظام المستشفيات</span>
                </a>
            </div>

            <div class="sidebar-wrapper d-flex flex-column">
                <nav class="mt-2 flex-grow-1">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" data-accordion="false">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link @Active("Home")">
                                <i class="nav-icon bi bi-grid-1x2"></i>
                                <p>لوحة التحكم</p>
                            </a>
                        </li>

                        @if (Can(AppPermissions.PatientsView, AppPermissions.AppointmentsView, AppPermissions.AppointmentsViewOwn, AppPermissions.MedicalRecordsView))
                        {
                            <li class="nav-header">الرعاية</li>
                        }
                        @if (Can(AppPermissions.AppointmentsView, AppPermissions.AppointmentsViewOwn))
                        {
                            <li class="nav-item">
                                <a asp-controller="Appointments" asp-action="Index" class="nav-link @Active("Appointments")">
                                    <i class="nav-icon bi bi-calendar2-check"></i>
                                    <p>المواعيد</p>
                                </a>
                            </li>
                        }
                        @if (Can(AppPermissions.PatientsView))
                        {
                            <li class="nav-item">
                                <a asp-controller="Patients" asp-action="Index" class="nav-link @Active("Patients")">
                                    <i class="nav-icon bi bi-people"></i>
                                    <p>المرضى</p>
                                </a>
                            </li>
                        }
                        @if (Can(AppPermissions.MedicalRecordsView))
                        {
                            <li class="nav-item">
                                <a asp-controller="MedicalRecords" asp-action="Index" class="nav-link @Active("MedicalRecords")">
                                    <i class="nav-icon bi bi-file-earmark-medical"></i>
                                    <p>السجلات الطبية</p>
                                </a>
                            </li>
                        }

                        @if (Can(AppPermissions.ClinicsView, AppPermissions.DoctorsView, AppPermissions.JobsManage))
                        {
                            <li class="nav-header">المستشفى</li>
                        }
                        @if (Can(AppPermissions.DoctorsView))
                        {
                            <li class="nav-item">
                                <a asp-controller="Doctors" asp-action="Index" class="nav-link @Active("Doctors")">
                                    <i class="nav-icon bi bi-person-badge"></i>
                                    <p>الأطباء</p>
                                </a>
                            </li>
                        }
                        @if (Can(AppPermissions.ClinicsView))
                        {
                            <li class="nav-item">
                                <a asp-controller="Clinics" asp-action="Index" class="nav-link @Active("Clinics")">
                                    <i class="nav-icon bi bi-hospital"></i>
                                    <p>العيادات</p>
                                </a>
                            </li>
                        }
                        @if (Can(AppPermissions.JobsManage))
                        {
                            <li class="nav-item">
                                <a asp-controller="Jobs" asp-action="Index" class="nav-link @Active("Jobs")">
                                    <i class="nav-icon bi bi-briefcase"></i>
                                    <p>المسميات الوظيفية</p>
                                </a>
                            </li>
                        }

                        @if (Can(AppPermissions.UsersManage, AppPermissions.RolesManage))
                        {
                            <li class="nav-header">إدارة النظام</li>
                        }
                        @if (Can(AppPermissions.UsersManage))
                        {
                            <li class="nav-item">
                                <a asp-controller="Users" asp-action="Index" class="nav-link @Active("Users")">
                                    <i class="nav-icon bi bi-person-gear"></i>
                                    <p>المستخدمين</p>
                                </a>
                            </li>
                        }
                        @if (Can(AppPermissions.RolesManage))
                        {
                            <li class="nav-item">
                                <a asp-controller="Roles" asp-action="Index" class="nav-link @Active("Roles")">
                                    <i class="nav-icon bi bi-shield-lock"></i>
                                    <p>الأدوار</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Permissions" asp-action="Index" class="nav-link @Active("Permissions")">
                                    <i class="nav-icon bi bi-key"></i>
                                    <p>الصلاحيات</p>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>

                <div class="sidebar-user">
                    <span class="avatar bg-primary"><i class="bi bi-person"></i></span>
                    <div class="overflow-hidden">
                        <div class="fw-bold text-truncate">@fullName</div>
                        <div class="text-muted-2 small text-truncate">@string.Join("، ", User.FindAll(UserService.ClaimRole).Select(c => c.Value))</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- المحتوى -->
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div>
                            <h1 class="page-title">@ViewData["Title"]</h1>
                            @if (ViewData["Subtitle"] != null)
                            {
                                <div class="page-subtitle">@ViewData["Subtitle"]</div>
                            }
                        </div>
                        <div class="ms-auto d-flex flex-wrap gap-2">
                            @await RenderSectionAsync("PageActions", required: false)
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-content">
                <div class="container-fluid">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </div>
        </main>

        <footer class="app-footer d-flex justify-content-between flex-wrap gap-2">
            <span>جميع الحقوق محفوظة &copy; @DateTime.Now.Year - نظام المستشفيات</span>
            <span class="text-muted-2">صُمّم بعناية <i class="bi bi-heart-fill text-danger"></i></span>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/overlayscrollbars/overlayscrollbars.browser.es6.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/template/js/adminlte.min.js"></script>
    <script>
        // إخفاء رسائل النجاح تلقائياً بعد 4 ثوانٍ
        setTimeout(() => document.querySelectorAll('.alert-success').forEach(a => bootstrap.Alert.getOrCreateInstance(a).close()), 4000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
