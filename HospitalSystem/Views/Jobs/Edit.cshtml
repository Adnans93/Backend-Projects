@model Job
@{
    ViewData["Title"] = "تعديل مسمى وظيفي";
}

<div class="card form-card-sm">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UID" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="مثال: استشاري" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i> حفظ التعديلات</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
