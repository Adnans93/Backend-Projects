@model IEnumerable<Permission>
@{
    ViewData["Title"] = "الصلاحيات";
    ViewData["Subtitle"] = "صلاحيات النظام، وتُمنح للأدوار من صفحة الأدوار";
}

@section PageActions {
    <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-light"><i class="bi bi-shield-lock me-1"></i> الأدوار</a>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> صلاحية إضافية</a>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>الصلاحية</th>
                    <th>المفتاح البرمجي</th>
                    <th>النوع</th>
                    <th style="width:110px">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var system = AppPermissions.IsSystem(item.Name);
                    <tr>
                        <td class="fw-bold"><i class="bi bi-key me-2 text-warning"></i>@AppPermissions.DisplayName(item.Name)</td>
                        <td><code dir="ltr">@item.Name</code></td>
                        <td>
                            @if (system)
                            {
                                <span class="badge badge-soft-info"><i class="bi bi-lock me-1"></i>أساسية</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-secondary">إضافية</span>
                            }
                        </td>
                        <td>
                            @if (!system)
                            {
                                <div class="actions">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-icon edit" title="تعديل"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="DeleteConfirmed" asp-route-id="@item.Id" method="post" onsubmit="return confirm('هل تريد حذف هذه الصلاحية؟');">
                                        <button type="submit" class="btn btn-icon danger" title="حذف"><i class="bi bi-trash3"></i></button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
